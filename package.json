{
  "name": "pi-codemode-bench",
  "version": "0.1.0",
  "private": true,
  "description": "Pi 코드 모드 툴이 스크립트를 쓰는 시간과 그 스크립트가 실행되는 시간을 기록합니다.",
  "type": "module",
  "license": "MIT",
  "keywords": [
    "pi-package"
  ],
  "engines": {
    "node": ">=22.19.0"
  },
  "scripts": {
    "test": "node --disable-warning=ExperimentalWarning --experimental-strip-types --test test/*.test.ts",
    "typecheck": "tsc --noEmit",
    "check": "npm run typecheck && npm test",
    "replay": "node --disable-warning=ExperimentalWarning --experimental-strip-types scripts/replay.ts",
    "report": "node --disable-warning=ExperimentalWarning --experimental-strip-types scripts/report.ts",
    "dev": "pi --tools +codemode"
  },
  "pi": {
    "extensions": [
      "./extensions/codemode-bench.ts"
    ]
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "*"
  },
  "devDependencies": {
    "@earendil-works/pi-coding-agent": "^1.3.0",
    "@types/node": "^22.20.5",
    "typescript": "^5.9.3"
  }
}
