{
  "name": "pi-codemode-usage",
  "version": "0.1.0",
  "description": "Record codemode script write and execution times in per-session SQLite files for Pi.",
  "type": "module",
  "license": "MIT",
  "author": "Hyein Cho",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/hyein-cbio/pi-codemode-usage.git"
  },
  "homepage": "https://github.com/hyein-cbio/pi-codemode-usage#readme",
  "bugs": {
    "url": "https://github.com/hyein-cbio/pi-codemode-usage/issues"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "keywords": [
    "pi-package",
    "pi-extension",
    "codemode",
    "usage"
  ],
  "files": [
    "extensions",
    "src",
    "README.md",
    "README.ko.md",
    "docs",
    "CHANGELOG.md",
    "SECURITY.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=22.19.0"
  },
  "scripts": {
    "test": "node --disable-warning=ExperimentalWarning --experimental-strip-types --test test/*.test.ts",
    "typecheck": "tsc --noEmit",
    "check": "npm run typecheck && npm test",
    "replay": "node --disable-warning=ExperimentalWarning --experimental-strip-types scripts/replay.ts",
    "report": "node --disable-warning=ExperimentalWarning --experimental-strip-types scripts/report.ts",
    "dev": "pi --tools +codemode"
  },
  "pi": {
    "extensions": [
      "./extensions/codemode-usage.ts"
    ]
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "*"
  },
  "devDependencies": {
    "@earendil-works/pi-coding-agent": "^1.3.0",
    "@types/node": "^26.6.5",
    "typescript": "^5.9.3"
  }
}
